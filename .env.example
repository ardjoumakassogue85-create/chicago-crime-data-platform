# ----- Chicago API -----
CHICAGO_API_BASE_URL=https://data.cityofchicago.org/resource/ijjp-q8t2.json
CHICAGO_APP_TOKEN=your_socrata_app_token_here

# ----- GCP -----
GCP_PROJECT_ID=chicago-crime-data-platform
GCP_BUCKET_NAME=chicago-crime-data-XYZ
GCP_REGION=europe-west1
GCP_SA_KEY_PATH=/home/USER/keys/chicago-de-sa.json

# ----- BigQuery -----
BQ_DATASET_STAGING=staging
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=marts

# ----- Airflow -----
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# ----- Slack (optionnel) -----
SLACK_WEBHOOK_URL=

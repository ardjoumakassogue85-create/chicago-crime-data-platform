[0m23:21:42.195950 [debug] [Thread-2 (]: On model.chicago_crime.dim_location: /* {"app": "dbt", "dbt_version": "1.7.20", "profile_name": "chicago_crime", "target_name": "prod", "node_id": "model.chicago_crime.dim_location"} */

  
    

    create or replace table `chicago-crime-data-platform`.`silver_marts`.`dim_location`
      
    
    

    OPTIONS()
    as (
      

-- Dimension Location : combinaisons uniques géographiques
WITH locations AS (
    SELECT
        district,
        beat,
        ward,
        community_area,
        block,
        location_description
    FROM `chicago-crime-data-platform`.`silver_staging`.`stg_crimes`
    GROUP BY 1, 2, 3, 4, 5, 6
),

ranked AS (
    SELECT
        ROW_NUMBER() OVER (
            ORDER BY 
                COALESCE(CAST(district AS STRING), 'UNKNOWN'),
                COALESCE(CAST(beat AS STRING), 'UNKNOWN')
        ) AS location_key,
        *
    FROM locations
)

SELECT * FROM ranked
    );
  

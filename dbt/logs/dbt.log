-- Dimension Crime : combinaisons uniques de (iucr, primary_type, description)
WITH crimes AS (
    SELECT 
        COALESCE(iucr, 'UNKNOWN') AS iucr,
        COALESCE(primary_type, 'UNKNOWN') AS primary_type,

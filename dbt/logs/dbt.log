    create or replace table `chicago-crime-data-platform`.`silver_marts`.`dim_time`
      
    
    

    OPTIONS()
    as (
      

-- Dimension Temps : générée à partir des heures/min distinctes
WITH time_spine AS (
    SELECT DISTINCT 
        crime_hour,
        EXTRACT(MINUTE FROM crime_datetime) AS minute
    FROM `chicago-crime-data-platform`.`silver_staging`.`stg_crimes`
),

dim_time AS (
    SELECT
        -- Clé : HHMM (ex: 1430)
        crime_hour * 100 + minute AS time_key,
        crime_hour AS hour,
        minute AS minute,
        CASE
            WHEN crime_hour BETWEEN 5 AND 11 THEN 'morning'
            WHEN crime_hour BETWEEN 12 AND 17 THEN 'afternoon'
            WHEN crime_hour BETWEEN 18 AND 21 THEN 'evening'
            ELSE 'night'
        END AS period
    FROM time_spine
)

SELECT * FROM dim_time
    );
  
[0m15:39:59.074235 [debug] [Thread-4 (]: On model.chicago_crime.dim_date: /* {"app": "dbt", "dbt_version": "1.7.20", "profile_name": "chicago_crime", "target_name": "dev", "node_id": "model.chicago_crime.dim_date"} */

  
    

    create or replace table `chicago-crime-data-platform`.`silver_marts`.`dim_date`
      
    
    

    OPTIONS()
    as (
      

-- Dimension Date : générée à partir des dates distinctes présentes dans les crimes
WITH date_spine AS (
    SELECT DISTINCT crime_date
    FROM `chicago-crime-data-platform`.`silver_staging`.`stg_crimes`
    WHERE crime_date IS NOT NULL
),

dim_date AS (
    SELECT
        -- Clé : YYYYMMDD en INT64
        CAST(FORMAT_DATE('%Y%m%d', crime_date) AS INT64) AS date_key,
        crime_date AS full_date,
        EXTRACT(YEAR FROM crime_date) AS year,
        EXTRACT(MONTH FROM crime_date) AS month,
        EXTRACT(QUARTER FROM crime_date) AS quarter,
        EXTRACT(DAY FROM crime_date) AS day_of_month,
        EXTRACT(DAYOFYEAR FROM crime_date) AS day_of_year,
        EXTRACT(DAYOFWEEK FROM crime_date) AS day_of_week,
        FORMAT_DATE('%A', crime_date) AS day_name,
        FORMAT_DATE('%B', crime_date) AS month_name,
        EXTRACT(ISOWEEK FROM crime_date) AS iso_week,
        CASE 
            WHEN EXTRACT(DAYOFWEEK FROM crime_date) IN (1, 7) 
            THEN TRUE ELSE FALSE 
        END AS is_weekend
    FROM date_spine
)

SELECT * FROM dim_date
    );
  

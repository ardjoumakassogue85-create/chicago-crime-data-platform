        COALESCE(fbi_code, 'UNKNOWN') AS fbi_code
    FROM `chicago-crime-data-platform`.`silver_staging`.`stg_crimes`
    GROUP BY 1, 2, 3, 4
),

ranked AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY iucr, primary_type) AS crime_type_key,
        *
    FROM crimes
)

SELECT * FROM ranked
